# WeatherLink v2 API credentials (https://www.weatherlink.com/account)
# Create an API key/secret under Account > API.
WEATHERLINK_API_KEY=your-api-key
WEATHERLINK_API_SECRET=your-api-secret

# Optional: default station id used by the CLI when one isn't passed.
# Find it with: wthr stations
WEATHERLINK_STATION_ID=
